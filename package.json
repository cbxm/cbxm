{
  "name": "cbxm-me",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cf": "astro build && cf-wrangler build",
    "preview": "bun run build:cf && cf-wrangler dev",
    "deploy": "bun run build:cf && cf deploy --prebuilt",
    "deploy:check": "bun run build:cf && cf deploy --prebuilt --dry-run"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "astro": "^7.4.5",
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.27",
    "wrangler": "4.156.2"
  }
}
