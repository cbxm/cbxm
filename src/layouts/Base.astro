---
import '../styles/global.css';
import { findPlace, lightSky } from '../scripts/sky-light';
import { zonesVersion } from '../lib/zones';

interface Props {
  title?: string;
  description?: string;
  /** On wide screens with JS, the page fills the viewport below the header and does not scroll (the map). */
  fullBleed?: boolean;
  /** The header's sky is a tall band rather than a strip. */
  tallSky?: boolean;
}

const { title, description = 'A writing playground that grows.', fullBleed = false, tallSky = false } = Astro.props;
const pageTitle = title ? `${title} · cbxm` : 'cbxm';
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const inGarden = path === '/ander' || path.startsWith('/ander/');

// Before first paint: find the viewer's place (loading the zone table on a first visit), then
// light the page, so a night visit never flashes the day palette. Two scripts, because a
// script that findPlace() writes in runs after the script that wrote it.
/** JS for an inline <script>, which must not contain its own end tag. */
const inline = (js: string) => js.replace(/<\/script/gi, '<\\/script');
const placeScript = inline(`document.documentElement.dataset.js = '';\n(${findPlace})('/sky-zones.js?v=${zonesVersion}', '${zonesVersion}');`);
const lightScript = inline(`(${lightSky})();`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title ?? 'cbxm'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta name="theme-color" content="#f3ede1" />
    <script is:inline set:html={placeScript} />
    <script is:inline set:html={lightScript} />
  </head>
  <body class:list={{ 'full-bleed': fullBleed }}>
    <header class:list={['site-header', { 'tall-sky': tallSky }]}>
      <div class="sky" data-band={tallSky ? 'tall' : 'strip'} aria-hidden="true">
        <span class="cloud" style="--x: 8vw; --y: 6%; --s: 1.1; --t: 720s; --o: 0s"></span>
        <span class="cloud" style="--x: 60vw; --y: 22%; --s: 0.8; --t: 600s; --o: 380s"></span>
        <span class="cloud" style="--x: 34vw; --y: 40%; --s: 0.6; --t: 900s; --o: 610s"></span>
      </div>
      <a class="wordmark" href="/" aria-label="cbxm, home">cbxm</a>
      <div class="header-end">
        <nav aria-label="Site">
          <a href="/ander" aria-current={inGarden ? 'page' : undefined}>meander</a>
        </nav>
        <button class="theme" type="button" aria-label="theme">
          <svg class="theme-icon theme-icon--light" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="3" />
            <path
              d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M3.4 12.6l1.3-1.3M11.3 4.7l1.3-1.3"
            />
          </svg>
          <svg class="theme-icon theme-icon--dynamic" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="5.5" />
            <path class="fill" d="M8 2.5a5.5 5.5 0 0 0 0 11z" />
          </svg>
          <svg class="theme-icon theme-icon--dark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M12.8 10A5.6 5.6 0 1 1 6 3.2a4.4 4.4 0 0 0 6.8 6.8z" />
          </svg>
        </button>
      </div>
      <span class="sky-label" aria-hidden="true" hidden></span>
    </header>
    <main>
      <slot />
    </main>
    {
      !fullBleed && (
        <footer class="site-footer">
          <span>cbxm.me</span>
          <span aria-hidden="true">·</span>
          <span>still growing</span>
        </footer>
      )
    }
  </body>
</html>

<script>
  import '../scripts/sky';
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
    padding: var(--space-3) var(--gutter);
  }

  :global(html[data-sky]) .tall-sky {
    min-height: var(--sky-band);
  }

  /* Above the sky, which only takes the pointer over its sun, moon, planets, and figures, and
     haloed in paper so the stars behind don't break up the letters. */
  .wordmark,
  .header-end {
    position: relative;
    z-index: 1;
    text-shadow:
      0 0 6px var(--paper),
      0 0 2px var(--paper);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* The theme cycles light → dynamic → dark (src/scripts/sky.ts); it needs the bootstrap's data-theme. */
  .theme {
    display: none;
    padding: var(--space-1);
    margin: calc(-1 * var(--space-1));
    border: 0;
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 0.2s;
  }

  :global(html[data-theme]) .theme {
    display: inline-flex;
  }

  .theme:hover {
    color: var(--ink);
  }

  .theme-icon {
    display: none;
    width: 1.1rem;
    height: 1.1rem;
    max-width: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 3px var(--paper));
  }

  .theme-icon .fill {
    fill: currentColor;
    stroke: none;
  }

  :global(html[data-theme='light']) .theme-icon--light,
  :global(html[data-theme='dynamic']) .theme-icon--dynamic,
  :global(html[data-theme='dark']) .theme-icon--dark {
    display: block;
  }

  .wordmark {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  nav a {
    font-style: italic;
    text-decoration: none;
    color: var(--ink-soft);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  main {
    flex: 1;
    width: 100%;
  }

  /* Matches the breakpoint where the map replaces the list (see ander/index.astro). */
  @media (min-width: 48rem) {
    :global(html[data-js]) .full-bleed {
      height: 100dvh;
      overflow: hidden;
    }

    :global(html[data-js]) .full-bleed main {
      position: relative;
      min-height: 0;
    }
  }

  .site-footer {
    display: flex;
    gap: var(--space-2);
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-6) var(--gutter) var(--space-4);
    font-style: italic;
    color: var(--ink-faint);
  }

  /* Sized on the children so the footer's own `ch`-based width matches the page column. */
  .site-footer > * {
    font-size: var(--text-sm);
  }
</style>
