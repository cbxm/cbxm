---
import Plant from './Plant.astro';
import { fieldBounds, gardenLinks, pieceHref, plantVariation, type Piece } from '../lib/garden';

interface Props {
  pieces: Piece[];
  /** Plants are links when true; a static picture otherwise. */
  interactive?: boolean;
}

const { pieces, interactive = false } = Astro.props;
const bounds = fieldBounds(pieces);
const originX = -bounds.left;
const originY = -bounds.top;

// Lower plants are drawn later so they overlap the ones behind them.
const planted = [...pieces].sort((a, b) => a.data.y - b.data.y);

/** Stable pseudo-random numbers in [0, 1) from a 32-bit seed. */
function stream(seed: number) {
  return () => {
    seed = (Math.imul(seed ^ (seed >>> 15), 2246822507) + 0x9e3779b9) >>> 0;
    return seed / 4294967296;
  };
}

/**
 * Grass tufts and pebbles so the open ground has texture. One mark per cell of map
 * space, seeded by the cell's coordinates, so the ground stays put as the field grows.
 */
function scatter() {
  const CELL = 290;
  const marks = [];
  for (let cx = Math.floor(bounds.left / CELL); cx * CELL < bounds.left + bounds.width; cx++) {
    for (let cy = Math.floor(bounds.top / CELL); cy * CELL < bounds.top + bounds.height; cy++) {
      const rand = stream((Math.imul(cx, 73856093) ^ Math.imul(cy, 19349663)) >>> 0);
      marks.push({
        x: Math.round((cx + rand()) * CELL - bounds.left),
        y: Math.round((cy + rand()) * CELL - bounds.top),
        kind: rand() < 0.78 ? 'tuft' : 'pebble',
        flip: rand() < 0.5 ? -1 : 1,
        scale: 0.7 + rand() * 0.6,
      });
    }
  }
  return marks;
}
const ground = scatter();

type Point = { x: number; y: number };
const fmt = (p: Point) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
const midpoint = (p: Point, q: Point) => ({ x: (p.x + q.x) / 2, y: (p.y + q.y) / 2 });

/** A smooth path through `points`, curving through the midpoints between them. */
function smooth(points: Point[]) {
  let d = `M${fmt(points[0])}`;
  for (let i = 1; i < points.length - 1; i++) d += ` Q${fmt(points[i])} ${fmt(midpoint(points[i], points[i + 1]))}`;
  return `${d} L${fmt(points[points.length - 1])}`;
}

/** The outline of a line along `spine` whose half-width at fraction t of the way along is `halfWidth(t)`. */
function ribbon(spine: Point[], halfWidth: (t: number) => number) {
  const last = spine.length - 1;
  const left: Point[] = [];
  const right: Point[] = [];
  spine.forEach((p, i) => {
    const prev = spine[Math.max(0, i - 1)];
    const next = spine[Math.min(last, i + 1)];
    const len = Math.hypot(next.x - prev.x, next.y - prev.y) || 1;
    const nx = -(next.y - prev.y) / len;
    const ny = (next.x - prev.x) / len;
    const w = halfWidth(i / last);
    left.push({ x: p.x + nx * w, y: p.y + ny * w });
    right.push({ x: p.x - nx * w, y: p.y - ny * w });
  });
  return `${smooth(left)} ${smooth(right.reverse()).replace(/^M/, 'L')} Z`;
}

/**
 * A root joining two plant bases underground: a gnarled arc, thickest where it leaves each plant and
 * thinnest where the two meet, with short rootlets branching off toward the middle. Seeded by `key`, so a
 * pair keeps its shape from build to build. Returns one path; every outline winds the same way, so the
 * rootlets fill as part of the root.
 */
function root(a: Point, b: Point, key: string) {
  let hash = 2166136261;
  for (let i = 0; i < key.length; i++) hash = Math.imul(hash ^ key.charCodeAt(i), 16777619);
  const rand = stream(hash >>> 0);

  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const length = Math.hypot(dx, dy);
  const bow = (0.08 + rand() * 0.12) * length * (rand() < 0.5 ? -1 : 1);
  const c = { x: (a.x + b.x) / 2 - (dy / length) * bow, y: (a.y + b.y) / 2 + (dx / length) * bow };
  const slow = { waves: Math.max(1, Math.round(length / 160)), phase: rand() * 2 * Math.PI, size: 3 + rand() * 3 };
  const quick = { waves: Math.max(2, Math.round(length / 45)), phase: rand() * 2 * Math.PI, size: 0.8 + rand() * 0.8 };

  /** The point at `t` along the arc, bent off it; the ends stay on the plants. */
  const at = (t: number) => {
    const u = 1 - t;
    const tx = 2 * u * (c.x - a.x) + 2 * t * (b.x - c.x);
    const ty = 2 * u * (c.y - a.y) + 2 * t * (b.y - c.y);
    const n = Math.hypot(tx, ty);
    const bend =
      Math.sin(Math.PI * t) *
      (slow.size * Math.sin(2 * Math.PI * slow.waves * t + slow.phase) +
        quick.size * Math.sin(2 * Math.PI * quick.waves * t + quick.phase));
    return {
      x: u * u * a.x + 2 * u * t * c.x + t * t * b.x - (ty / n) * bend,
      y: u * u * a.y + 2 * u * t * c.y + t * t * b.y + (tx / n) * bend,
      angle: Math.atan2(ty, tx),
    };
  };
  /** Half the root's width: about 3px wide at each plant, under 1px where the two halves meet. */
  const thickness = (t: number) => 0.4 + 1.2 * Math.abs(2 * t - 1) ** 1.6;

  const steps = Math.max(8, Math.round(length / 9));
  const spine = Array.from({ length: steps + 1 }, (_, i) => at(i / steps));
  let d = ribbon(spine, thickness);

  const count = Math.max(2, Math.round(length / 55));
  for (let i = 0; i < count; i++) {
    const t = 0.08 + (0.84 * (i + 0.2 + rand() * 0.6)) / count;
    const p = at(t);
    // Rootlets lean away from the plant they grow from, toward where the root thins.
    const ahead = t < 0.5 ? 0 : Math.PI;
    const side = rand() < 0.5 ? 1 : -1;
    const angle = p.angle + ahead + side * (0.5 + rand() * 0.6);
    const reach = 6 + rand() * 12;
    const curl = side * (rand() - 0.3) * reach * 0.4;
    const tip = { x: p.x + Math.cos(angle) * reach, y: p.y + Math.sin(angle) * reach };
    const bendAt = {
      x: (p.x + tip.x) / 2 - Math.sin(angle) * curl,
      y: (p.y + tip.y) / 2 + Math.cos(angle) * curl,
    };
    const twig = [0, 1 / 3, 2 / 3, 1].map((s) => ({
      x: (1 - s) ** 2 * p.x + 2 * (1 - s) * s * bendAt.x + s * s * tip.x,
      y: (1 - s) ** 2 * p.y + 2 * (1 - s) * s * bendAt.y + s * s * tip.y,
    }));
    const base = thickness(t) * 0.8;
    d += ` ${ribbon(twig, (s) => base * (1 - s) + 0.1)}`;
  }

  return d;
}

/** One root per linked pair, whichever way the links run. */
const roots = (() => {
  const base = new Map(pieces.map((p) => [p.id, { x: originX + p.data.x, y: originY + p.data.y }]));
  const grown = new Set<string>();
  return gardenLinks(pieces).flatMap((link) => {
    const [a, b] = [link.from, link.to].sort();
    const key = `${a} ${b}`;
    if (grown.has(key)) return [];
    grown.add(key);
    const [from, to] = [base.get(a)!, base.get(b)!];
    if (from.x === to.x && from.y === to.y) {
      console.warn(`[garden] ${a} and ${b} are linked but planted at the same x, y, so no root joins them`);
      return [];
    }
    return [{ ...link, d: root(from, to, key) }];
  });
})();

const Tag = interactive ? 'a' : 'span';
---

<div
  class="field"
  style={`width: ${bounds.width}px; height: ${bounds.height}px; --origin-x: ${originX}px; --origin-y: ${originY}px;`}
  data-origin-x={originX}
  data-origin-y={originY}
  data-width={bounds.width}
  data-height={bounds.height}
>
  <svg class="roots" width={bounds.width} height={bounds.height} aria-hidden="true">
    {
      roots.map((r) => (
        <g class="root" data-from={r.from} data-to={r.to}>
          <path class="root-glow" d={r.d} />
          <path class="root-body" d={r.d} />
        </g>
      ))
    }
  </svg>

  <svg class="ground" width={bounds.width} height={bounds.height} aria-hidden="true">
    {
      ground.map((g) =>
        g.kind === 'tuft' ? (
          <path
            transform={`translate(${g.x} ${g.y}) scale(${g.flip * g.scale} ${g.scale})`}
            d="M-5 0 Q-5 -4 -7 -7 M0 0 Q0 -6 1 -10 M4 0 Q5 -3 8 -5"
          />
        ) : (
          <ellipse cx={g.x} cy={g.y} rx={2.4 * g.scale} ry={1.6 * g.scale} />
        ),
      )
    }
  </svg>

  {
    planted.map((piece) => {
      const v = plantVariation(piece.id);
      return (
        <Tag
          class="sprig"
          href={interactive ? pieceHref(piece) : undefined}
          tabindex={interactive ? -1 : undefined}
          draggable={interactive ? 'false' : undefined}
          data-slug={piece.id}
          style={`left: ${originX + piece.data.x}px; top: ${originY + piece.data.y}px; --flip: ${v.flip ? -1 : 1}; --lean: ${v.lean.toFixed(2)}deg; --scale: ${v.scale.toFixed(3)};`}
        >
          <span class="sprig-form">
            <Plant stage={piece.data.stage} />
          </span>
          <span class="sprig-label">{piece.data.title}</span>
        </Tag>
      );
    })
  }
</div>

<style>
  .field {
    position: relative;
    /* The /ander map sets --zoom when the reader pinches or ctrl+scrolls. */
    zoom: var(--zoom, 1);
    background-image: radial-gradient(circle, color-mix(in srgb, var(--ink) 7%, transparent) 1px, transparent 1.6px);
    background-size: 56px 56px;
    background-position: calc(var(--origin-x) - 28px) calc(var(--origin-y) - 28px);
  }

  .roots {
    position: absolute;
    inset: 0;
    max-width: none;
    pointer-events: none;
  }

  .root {
    opacity: 0.5;
    transition: opacity 0.3s;
  }

  /* Toward the ink, so roots lighten against the night palette as well as darken by day. */
  .root-body {
    fill: color-mix(in oklab, var(--bark), var(--ink) 30%);
  }

  .root-glow {
    fill: none;
    stroke: var(--accent-soft);
    stroke-width: 4;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .root.is-lit {
    opacity: 0.95;
  }

  .root.is-lit .root-glow {
    opacity: 1;
  }

  .ground {
    position: absolute;
    inset: 0;
    max-width: none;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.22;
    pointer-events: none;
  }

  .ground ellipse {
    fill: var(--ink-faint);
    stroke: none;
  }

  .sprig {
    position: absolute;
    width: 0;
    height: 0;
    color: var(--ink-soft);
    text-decoration: none;
  }

  /* Soft shadow where the plant meets the ground. */
  .sprig::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: calc(54px * var(--scale));
    height: calc(12px * var(--scale));
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--shadow), transparent);
  }

  .sprig-form {
    position: absolute;
    left: 0;
    bottom: 0;
    display: block;
    transform-origin: 50% 100%;
    transform: translateX(-50%) rotate(var(--lean)) scale(calc(var(--flip) * var(--scale)), var(--scale));
  }

  .sprig-form :global(.plant) {
    transform-origin: 50% 100%;
  }

  .sprig-label {
    position: absolute;
    left: 0;
    top: 0.6rem;
    translate: -50% 0;
    width: max-content;
    max-width: 17ch;
    /* Zoomed out, labels shrink with the map only as far as they stay readable. */
    font-size: max(0.95rem, calc(0.6rem / var(--zoom, 1)));
    font-style: italic;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
    /* Keeps the label legible where roots run beneath it. */
    text-shadow:
      0 0 2px var(--paper),
      0 0 4px var(--paper),
      0 0 8px var(--paper);
    transition: color 0.25s;
  }

  a.sprig:hover,
  .sprig.is-lit,
  .sprig.is-kin {
    color: var(--ink);
  }

  a.sprig:hover .sprig-label,
  .sprig.is-lit .sprig-label {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  a.sprig:hover :global(.plant),
  .sprig.is-lit :global(.plant) {
    animation: sway 2.4s ease-in-out infinite;
  }

  /* Plants at the other end of a lit root stir too, more gently and out of step. */
  .sprig.is-kin :global(.plant) {
    --sway: 0.5;
    animation: sway 3.1s ease-in-out infinite;
  }

  @keyframes sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    30% {
      transform: rotate(calc(2.5deg * var(--sway, 1)));
    }
    70% {
      transform: rotate(calc(-2deg * var(--sway, 1)));
    }
  }
</style>
