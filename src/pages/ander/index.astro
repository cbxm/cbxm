---
import Base from '../../layouts/Base.astro';
import GardenField from '../../components/GardenField.astro';
import Plant from '../../components/Plant.astro';
import { getGarden, pieceHref } from '../../lib/garden';

const pieces = await getGarden();
const dateFormat = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base title="meander" description="The garden: everything written here, planted on a map and growing." fullBleed tallSky>
  <div class="meander">
    <div class="map" aria-hidden="true" tabindex="-1">
      <GardenField pieces={pieces} interactive />
    </div>

    <section class="index" aria-labelledby="index-title">
      <div class="index-head">
        <h1 id="index-title">meander</h1>
        <button class="fold" type="button" aria-label="hide the list" aria-expanded="true" aria-controls="index-body">
          <svg class="chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path d="M2.5 7.75 6 4.25l3.5 3.5" />
          </svg>
        </button>
      </div>
      <div class="index-body" id="index-body">
        <p class="hint">
          <span class="hint-list">Everything planted here so far, newest first.</span>
          <span class="hint-map" aria-hidden="true">Drag to wander. The bigger the plant, the further along the piece.</span>
        </p>
        <ol class="pieces">
          {
            pieces.map((piece) => (
              <li id={piece.id} data-slug={piece.id}>
                <a href={pieceHref(piece)}>
                  <span class="glyph">
                    <Plant stage={piece.data.stage} height="1.5em" />
                  </span>
                  <span class="title">{piece.data.title}</span>
                </a>
                <p class="meta">
                  <span>{piece.data.stage}</span>
                  <span aria-hidden="true">·</span>
                  <time datetime={piece.data.date.toISOString().slice(0, 10)}>{dateFormat.format(piece.data.date)}</time>
                </p>
                {piece.data.description && <p class="description">{piece.data.description}</p>}
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </div>
</Base>

<style>
  /* List view: phones, no-JS, and the reading order for screen readers everywhere. */
  .map {
    display: none;
  }

  .index {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-4) var(--gutter) var(--space-6);
  }

  .index-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  h1 {
    font-size: var(--text-xl);
    font-style: italic;
  }

  /* Folding the legend away is for the map view only. */
  .fold {
    display: none;
  }

  .hint {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .hint-map {
    display: none;
  }

  .pieces {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
  }

  .pieces li + li {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .pieces a {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    font-size: var(--text-lg);
    line-height: 1.3;
    text-decoration: none;
  }

  .pieces a:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .glyph {
    flex: none;
    display: flex;
    justify-content: center;
    width: 1.6em;
  }

  .pieces .meta {
    margin-top: var(--space-1);
    display: flex;
    gap: var(--space-2);
  }

  .description {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  /* Map view: wide screens with JS. The list becomes the map's legend. */
  @media (min-width: 48rem) {
    :global(html[data-js]) .meander {
      position: absolute;
      inset: 0;
    }

    :global(html[data-js]) .map {
      display: block;
      position: absolute;
      inset: 0;
      overflow: auto;
      scrollbar-width: none;
      cursor: grab;
      overscroll-behavior: contain;
      /* A pinch over the map zooms the map (garden-map.ts), never the page as well. */
      touch-action: pan-x pan-y;
      -webkit-user-select: none;
      user-select: none;
      /* Fade the field into the header and edges. */
      mask-image: linear-gradient(to bottom, transparent, #000 2.5rem, #000 calc(100% - 2rem), transparent),
        linear-gradient(to right, transparent, #000 2rem, #000 calc(100% - 2rem), transparent);
      mask-composite: intersect;
    }

    :global(html[data-js]) .map::-webkit-scrollbar {
      display: none;
    }

    :global(html[data-js]) .map.is-dragging {
      cursor: grabbing;
    }

    :global(html[data-js]) .map.is-dragging :global(.sprig) {
      pointer-events: none;
    }

    :global(html[data-js]) .index {
      position: absolute;
      top: var(--space-3);
      left: var(--gutter);
      width: min(19rem, calc(100% - 2 * var(--gutter)));
      max-height: calc(100% - 2 * var(--space-3));
      overflow-y: auto;
      padding: var(--space-4);
      background: color-mix(in srgb, var(--paper-light) 92%, transparent);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      box-shadow: 0 1px 0 var(--paper-light) inset, 0 10px 30px -18px rgb(42 37 31 / 0.35);
      backdrop-filter: blur(3px);
    }

    :global(html[data-js]) .index.is-folded {
      width: max-content;
    }

    :global(html[data-js]) .is-folded .index-body {
      display: none;
    }

    :global(html[data-js]) h1 {
      font-size: var(--text-lg);
    }

    :global(html[data-js]) .fold {
      display: grid;
      place-items: center;
      flex: none;
      width: 1.75rem;
      height: 1.75rem;
      margin: -0.25rem -0.5rem -0.25rem 0;
      padding: 0;
      border: 0;
      border-radius: var(--radius);
      background: none;
      color: var(--ink-faint);
      cursor: pointer;
      transition: color 0.2s;
    }

    :global(html[data-js]) .fold:hover {
      color: var(--accent);
    }

    .chevron {
      width: 0.8rem;
      height: 0.8rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Only turns once the reader folds or unfolds it, not when a remembered state is restored. */
    .is-turning .chevron {
      transition: rotate 0.25s var(--ease-out);
    }

    .is-folded .chevron {
      rotate: 180deg;
    }

    :global(html[data-js]) .hint {
      font-size: var(--text-sm);
    }

    :global(html[data-js]) .hint-list {
      display: none;
    }

    :global(html[data-js]) .hint-map {
      display: inline;
    }

    :global(html[data-js]) .pieces {
      margin-top: var(--space-3);
    }

    :global(html[data-js]) .pieces li + li {
      margin-top: var(--space-2);
      padding-top: var(--space-2);
    }

    :global(html[data-js]) .pieces a {
      font-size: 1rem;
    }

    :global(html[data-js]) .pieces .meta {
      margin-left: calc(1.6em + var(--space-2));
      font-size: 0.68rem;
    }

    :global(html[data-js]) .description {
      display: none;
    }
  }
</style>

<script>
  import { plantGardenMap } from '../../scripts/garden-map';

  plantGardenMap();
</script>
