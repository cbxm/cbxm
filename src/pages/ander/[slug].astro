---
import { render } from 'astro:content';
import PieceLayout from '../../layouts/Piece.astro';
import { backlinks, getGarden, type Piece } from '../../lib/garden';

export async function getStaticPaths() {
  const pieces = await getGarden();
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece, linkedFrom: backlinks(piece, pieces) } }));
}

const { piece, linkedFrom } = Astro.props as { piece: Piece; linkedFrom: Piece[] };
const { Content } = await render(piece);
---

<PieceLayout piece={piece} linkedFrom={linkedFrom}>
  <Content />
</PieceLayout>
