---
import Base from '../layouts/Base.astro';
import GardenField from '../components/GardenField.astro';
import { getGarden } from '../lib/garden';

const pieces = await getGarden();
---

<Base description="hi. i’m caden.">
  <div class="home">
    <section class="handshake prose" aria-labelledby="hello">
      <h1 id="hello">hi. i’m caden.</h1>
      <p>
        i live in ogden, utah, with a dog named sophie and a car that has opinions about which way we’re going.
      </p>
      <p>
        for eight years i climbed trees for a living. now i mostly write software. i’m also starting a tree company,
        because apparently i can’t leave well enough alone.
      </p>
      <p>
        i build systems: for code, for crews, for getting out of bed in the morning. most of them work. some of them
        are very elaborate ways of avoiding the one thing i’m supposed to be doing. i’m getting better at telling which
        is which.
      </p>
      <p>sometimes i write essays. some are gentle and some are rude. all of them are honest.</p>
      <p>
        i like dinner parties, card games, long drives with no route, and the kind of conversation that keeps going
        after the dishes are done.
      </p>
      <p>
        if you’re a friend, hi. if you’re a stranger, also hi. you probably got here by taking a wrong turn.
      </p>
      <p>good. that’s my favorite way to get anywhere.</p>
    </section>

    <a class="glimpse" href="/ander">
      <span class="window" aria-hidden="true">
        <GardenField pieces={pieces} />
      </span>
      <span class="caption">wander into the garden &rarr;</span>
    </a>
  </div>
</Base>

<style>
  .home {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-6) var(--gutter) 0;
  }

  h1 {
    font-size: clamp(var(--text-xl), 6vw, 3.25rem);
    margin-bottom: var(--space-4);
  }

  .handshake p {
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .glimpse {
    display: block;
    margin-top: var(--space-6);
    text-decoration: none;
  }

  .window {
    position: relative;
    display: block;
    height: 260px;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, #000 3rem, #000 calc(100% - 2rem), transparent),
      linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    mask-composite: intersect;
  }

  /* Center the window on the map's origin. Narrow screens see the garden from further away. */
  .window :global(.field) {
    --glimpse-scale: 1;
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: var(--origin-x) var(--origin-y);
    translate: calc(-1 * var(--origin-x)) calc(-1 * var(--origin-y));
    scale: var(--glimpse-scale);
  }

  @media (max-width: 40rem) {
    .window :global(.field) {
      --glimpse-scale: 0.62;
    }
  }

  .caption {
    display: block;
    margin-top: var(--space-2);
    text-align: center;
    font-style: italic;
    color: var(--ink-soft);
    transition: color 0.2s;
  }

  .glimpse:hover .caption {
    color: var(--accent);
  }
</style>
